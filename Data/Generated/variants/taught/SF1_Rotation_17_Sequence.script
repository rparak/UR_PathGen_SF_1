movej(get_inverse_kin(drop_rotate_1_p, qnear=drop_rotate_1_q), a=1.3962634015954636, v=1.0471975511965976)
movel(Waypoint_4_p, a=1.2, v=0.25)
# Gripper open: the program's Robotiq node goes here (rq_set_pos_spd_for(0, 255, 255, "1"))
movej(get_inverse_kin(Waypoint_5_p, qnear=Waypoint_5_q), a=1.3962634015954636, v=1.0471975511965976)
movej(get_inverse_kin(Waypoint_1_p, qnear=Waypoint_1_q), a=1.3962634015954636, v=1.0471975511965976, r=0.05)
movej(get_inverse_kin(Waypoint_2_p, qnear=Waypoint_2_q), a=1.3962634015954636, v=1.0471975511965976, r=0.01)
movej(get_inverse_kin(Waypoint_3_p, qnear=Waypoint_3_q), a=1.3962634015954636, v=1.0471975511965976, r=0.05)
movej(get_inverse_kin(Waypoint_18_p, qnear=Waypoint_18_q), a=1.3962634015954636, v=1.0471975511965976)
movej(get_inverse_kin(pick_rotate_1_p, qnear=pick_rotate_1_q), a=1.3962634015954636, v=1.0471975511965976)
